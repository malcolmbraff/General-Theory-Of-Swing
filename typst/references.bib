@article{braffGeneralTheoryRhythm2015,
	title = {Towards a General Theory of Rhythm: Microtime, Phrasing, and Functional Rhythm},
	rights = {Creative Commons Attribution 4.0 International},
	url = {https://zenodo.org/doi/10.5281/zenodo.19386788},
	doi = {10.5281/ZENODO.19386788},
	shorttitle = {Towards a General Theory of Rhythm},
	abstract = {This working paper compiles four theoretical articles originally published at general-theory-of-rhythm.org in July 2015. They present the foundational concepts of the General Theory of Rhythm: a framework for describing, notating, and composing with microtime, phrasing, and functional rhythm.

 

Contents:



Basic Principles — Phrasing, Morphing, Groove, Tempered Harmonisation, Notation system

2. Diversity of Grooves: It's All About Da Weight — Canonical patterns, potential energy, groove balance, polygon model

3. Inaccuracy of the Common Metric System — Critique of Western notation, phrased microtime

4. Salsa is a Major Chord — Functional Rhythm applied to Afro-Cuban music


These concepts were first implemented computationally in the {WohlTemperiertesPhrasierApparat} ({WTPA}), a Max/{MSP} patch first published 24 July 2011 (Zenodo: https://doi.org/10.5281/zenodo.19385028).

 

Cited in: De Wet, D.J.S. (2017). Malcolm Braff's approach to rhythm for improvisation. {MMUS} thesis, University of the Witwatersrand. Suárez, P.J. (2023). El lenguaje musical del chamamé. Revista del Instituto Superior de Música, 22. Diaz, Z. (2023). Signifyin(g) Producers. {PhD} thesis, University of Bristol.},
	publisher = {Zenodo},
	author = {Braff, Malcolm},
	date = {2015-07},
	keywords = {General Theory of Rhythm, functional rhythm, groove, jazz, microrhythm, microtime, music theory, notation, phrasing, rhythm theory, swing, tuplet},
}

