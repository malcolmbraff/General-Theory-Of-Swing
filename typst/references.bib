	doi = {10.5281/ZENODO.19445195},
	abstract = {"Morph Congas" (derived from "Good Morning Sincity") is a composition for two-voice percussion exploring mirrored swinging subdivision systems. The score presents seven paired systems with shifting time signatures (7/8, 11/8, 4/4, 12/8, 9/8, 15/8, 5/4, 5/8, 7/8...), each combining two subdivisions with inverted swing morphing trajectories (0\%→100\% and 100\%→0\%). The audio recording demonstrates the full morphing cycle, repeated over approximately 30 minutes.},
